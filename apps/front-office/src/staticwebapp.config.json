{
  "routes": [
    {
      "route": "/ngsw-worker.js",
      "headers": { "Cache-Control": "no-cache" }
    },
    {
      "route": "/ngsw.json",
      "headers": { "Cache-Control": "no-cache" }
    },
    {
      "route": "/safety-worker.js",
      "headers": { "Cache-Control": "no-cache" }
    },
    {
      "route": "/worker-basic.min.js",
      "headers": { "Cache-Control": "no-cache" }
    },
    {
      "route": "/assets/*",
      "headers": { "Cache-Control": "public, must-revalidate, max-age=30" }
    },
    {
      "route": "/*.{js,css}",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" }
    },
    {
      "route": "/*.{map,ico,png,jpg,jpeg,gif,svg,webp,woff,woff2,ttf,eot,txt,json,webmanifest}",
      "headers": { "Cache-Control": "public, must-revalidate, max-age=30" }
    },
    {
      "route": "/*",
      "headers": { "Cache-Control": "no-cache" }
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/",
      "/*.css",
      "/*.js",
      "/manifest.webmanifest",
      "/ngsw.json"
    ]
  },
  "globalHeaders": {
    "referrer-policy": "strict-origin-when-cross-origin"
  }
}
